# Copie para .env. Gere valores aleatórios independentes; nunca versione .env.
APP_ENV=development
APP_SECRET=
WHATSAPP_WEB_SECRET=
CORS_ORIGINS=http://localhost
PUBLIC_APP_URL=http://localhost
# Produção com compose.production.yml: FRONTEND_BIND=127.0.0.1 e FRONTEND_PORT=8080
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80
# Domínio sem https://, usado somente na implantação pública:
APP_DOMAIN=
PLATFORM_ADMIN_EMAIL=admin@atendeia.com
# Apenas para criação inicial; usuários existentes nunca têm a senha substituída.
PLATFORM_ADMIN_PASSWORD=
SEED_DEMO=false
DEMO_OWNER_EMAIL=demo@atendeia.com
DEMO_OWNER_PASSWORD=
META_GRAPH_VERSION=v26.0
META_APP_SECRET=
# Execução do backend fora do Docker:
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=atende_ia
WHATSAPP_WEB_SERVICE_URL=http://127.0.0.1:3002
# SMTP (recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
